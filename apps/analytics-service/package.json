{
  "name": "analytics-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration:generate": "node --import tsx ../../node_modules/typeorm/cli.js migration:generate src/migrations/CreateAnalyticsTables -d src/database/data-source.ts",
    "migration:run": "node --import tsx ../../node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "node --import tsx ../../node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:show": "node --import tsx ../../node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts"
  },
  "dependencies": {
    "@amm/contracts": "1.0.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/microservices": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/typeorm": "^12.0.2",
    "dotenv": "^18.0.3",
    "joi": "^18.3.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "12.3.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "protobufjs": "^7.6.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-proto": "^2.18.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
